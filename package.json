{
  "name": "mobidesk",
  "version": "1.0.0",
  "description": "Android phone and tablet manager for Windows",
  "main": "main.js",
  "author": "MobiDesk",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "dist:dir": "electron-builder --win dir",
    "dist:portable": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\make-portable.ps1"
  },
  "devDependencies": {
    "electron": "^45.3.4",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.mobidesk.desktop",
    "productName": "MobiDesk",
    "directories": { "output": "release" },
    "files": ["main.js", "preload.js", "renderer/**/*", "assets/**/*", "package.json"],
    "extraResources": [{ "from": "tools", "to": "tools", "filter": ["**/*"] }],
    "win": { "target": ["nsis"], "icon": "assets/mobidesk.ico", "artifactName": "MobiDesk-Setup-${version}.${ext}" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true }
  }
}
