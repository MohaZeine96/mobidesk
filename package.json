{
  "name": "mobidesk",
  "version": "1.1.1",
  "description": "Android phone and tablet manager for Windows",
  "main": "main.js",
  "author": "MobiDesk",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis",
    "build:dir": "electron-builder --win dir",
    "build:portable": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\make-portable.ps1",
    "dist": "npm run build",
    "dist:dir": "npm run build:dir",
    "dist:portable": "npm run build:portable"
  },
  "devDependencies": {
    "electron": "^45.3.4",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.mobidesk.desktop",
    "productName": "MobiDesk",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "tools",
        "to": "tools",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/mobidesk.ico",
      "artifactName": "MobiDesk-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
